rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Setiap user (termasuk anonim) hanya bisa mengakses jadwal miliknya sendiri.
    match /users/{uid}/jadwals/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
